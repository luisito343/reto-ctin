server {
    listen 80;

    # -----------------------
    # CORS global
    # -----------------------
    add_header 'Access-Control-Allow-Origin' $http_origin always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Origin, Content-Type, Accept, Authorization' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    # -----------------------
    # Healthcheck
    # -----------------------
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # -----------------------
    # Fallback root
    # -----------------------
    location = / {
        return 200 'API Gateway activo';
        add_header Content-Type text/plain;
    }

    # -----------------------
    # STARTUPS
    # -----------------------

    # CREATE
    location /v1/api/startups/create {
        rewrite ^/v1/api/startups/create/?(.*)$ /$1 break;
        proxy_pass https://${CREATE_STARTUP_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${CREATE_STARTUP_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # READ
    location /v1/api/startups/read {
        rewrite ^/v1/api/startups/read/?(.*)$ /$1 break;
        proxy_pass https://${READ_STARTUP_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${READ_STARTUP_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # UPDATE (con :id)
    location /v1/api/startups/update/ {
        rewrite ^/v1/api/startups/update/(.*)$ /$1 break;
        proxy_pass https://${UPDATE_STARTUP_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${UPDATE_STARTUP_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # DELETE (con :id)
    location /v1/api/startups/delete/ {
        rewrite ^/v1/api/startups/delete/(.*)$ /$1 break;
        proxy_pass https://${DELETE_STARTUP_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${DELETE_STARTUP_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # -----------------------
    # TECHNOLOGIES
    # -----------------------

    # CREATE
    location /v1/api/technologies/create {
        rewrite ^/v1/api/technologies/create/?(.*)$ /$1 break;
        proxy_pass https://${CREATE_TECHNOLOGY_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${CREATE_TECHNOLOGY_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # READ
    location /v1/api/technologies/read {
        rewrite ^/v1/api/technologies/read/?(.*)$ /$1 break;
        proxy_pass https://${READ_TECHNOLOGY_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${READ_TECHNOLOGY_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # UPDATE (con :id)
    location /v1/api/technologies/update/ {
        rewrite ^/v1/api/technologies/update/(.*)$ /$1 break;
        proxy_pass https://${UPDATE_TECHNOLOGY_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${UPDATE_TECHNOLOGY_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # DELETE (con :id)
    location /v1/api/technologies/delete/ {
        rewrite ^/v1/api/technologies/delete/(.*)$ /$1 break;
        proxy_pass https://${DELETE_TECHNOLOGY_URL}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${DELETE_TECHNOLOGY_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }
}

