# Define un grupo de servidores para cada microservicio. 
# El nombre (ej. "create_startup") es una variable que usaremos más abajo.
# El "server" apunta al nombre del servicio en docker-compose y su puerto interno.
# Define un grupo de servidores para cada microservicio.
# nginx.conf.template (Versión Final para Plan Gratuito)

# No necesitamos un formato de log especial
# No necesitamos definir upstreams por separado

server {
    listen 80;

    # Rutas para Startups
    location /v1/api/startups/create {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://create-startup-service.onrender.com; 
    }
    location /v1/api/startups/read {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://read-startup-service.onrender.com;
    }
    location /v1/api/startups/update {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://update-startup-service.onrender.com;
    }
    location /v1/api/startups/delete {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://delete-startup-service.onrender.com;
    }

    # Rutas para Technologies
    location /v1/api/technologies/create {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://create-technology-service.onrender.com;
    }
    location /v1/api/technologies/read {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://read-technology-service.onrender.com;
    }
    location /v1/api/technologies/update {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://update-technology-service.onrender.com;
    }
    location /v1/api/technologies/delete {
        proxy_set_header      Host $host;
        proxy_ssl_server_name on;
        proxy_pass            https://delete-technology-service.onrender.com;
    }
}